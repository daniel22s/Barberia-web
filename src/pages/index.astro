---
import Base from "../layouts/Base.astro";
import Cabecera from "../components/Cabecera.astro";
import Pie from "../components/Pie.astro";
import Portada from "../components/Portada.astro";
import Franja from "../components/Franja.astro";
import Servicios from "../components/Servicios.astro";
import ComoReservar from "../components/ComoReservar.astro";
import Galeria from "../components/Galeria.astro";
import AntesDespues from "../components/AntesDespues.astro";
import Resenas from "../components/Resenas.astro";
import BotonWhatsApp from "../components/BotonWhatsApp.astro";
import Ubicacion from "../components/Ubicacion.astro";
import LlamadoFinal from "../components/LlamadoFinal.astro";
import Faq from "../components/Faq.astro";
---

<Base>
  <Cabecera />
  <main id="contenido" tabindex="-1">
    <Portada />
    <Franja />
    <Servicios />
    <ComoReservar />
    <Galeria />
    <AntesDespues />
    <Resenas />
    <Ubicacion />
    <Faq />
    <LlamadoFinal />
  </main>
  <Pie />
  <BotonWhatsApp />
</Base>
<script>
  import "../scripts/aparecer";
</script>
