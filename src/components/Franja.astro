---
import { getCollection } from "astro:content";
const estilos = (await getCollection("servicios")).sort(
  (a, b) => a.data.orden - b.data.orden,
);
---

<div class="franja" aria-label="Nuestros estilos">
  <label class="pausa">
    <input type="checkbox" />
    Pausar franja
  </label>
  <div class="cinta">
    {[false, true].map((copia) => (
      <ul aria-hidden={copia ? "true" : undefined}>
        {estilos.map(({ data }) => (
          <li>
            {data.nombre}
            <span aria-hidden="true"> ✦ </span>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>
<style>
  .franja {
    overflow: hidden;
    background: var(--color-acento);
    color: var(--color-sobre-acento);
    padding: 1rem 0;
  }
  .pausa {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    width: fit-content;
    margin: 0 auto 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
  }
  input {
    width: 20px;
    height: 20px;
    accent-color: var(--color-sobre-acento);
  }
  input:focus-visible {
    outline-color: var(--color-sobre-acento);
  }
  .franja:has(input:checked) .cinta {
    animation-play-state: paused;
  }
  .cinta {
    display: flex;
    width: max-content;
    animation: deslizar 40s linear infinite;
  }
  ul {
    display: flex;
    gap: 1.5rem;
    padding: 0 1rem;
    margin: 0;
    list-style: none;
    white-space: nowrap;
    font: 1.5rem var(--font-titulo);
    text-transform: uppercase;
  }
  @keyframes deslizar {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pausa {
      display: none;
    }
    .cinta {
      animation: none;
      width: auto;
    }
    ul {
      flex-wrap: wrap;
      white-space: normal;
    }
    ul[aria-hidden] {
      display: none;
    }
  }
</style>
