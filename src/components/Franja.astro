---
import { getCollection } from "astro:content";
const estilos = (await getCollection("servicios")).sort(
  (a, b) => a.data.orden - b.data.orden,
);
---

<div class="franja" aria-label="Nuestros estilos">
  <label class="control-movimiento" title="Pausar o reanudar animaciones">
    <input
      id="pausar-animaciones"
      type="checkbox"
      aria-label="Pausar animaciones"
    />
    <span aria-hidden="true">Ⅱ</span>
  </label>
  <div class="cinta">
    {[false, true].map((copia) => (
      <ul aria-hidden={copia ? "true" : undefined}>
        {estilos.map(({ data }) => (
          <li>
            {data.nombre}
            <span aria-hidden="true"> ✦ </span>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>
<style>
  .franja {
    position: relative;
    overflow: hidden;
    background: var(--color-acento);
    color: var(--color-sobre-acento);
    padding: 1rem 0;
  }
  .control-movimiento {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: 48px;
    display: grid;
    place-items: center;
    background: var(--color-acento);
    box-shadow: -12px 0 16px var(--color-acento);
    cursor: pointer;
  }
  .control-movimiento input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .control-movimiento:focus-within {
    outline: 3px solid var(--color-sobre-acento);
    outline-offset: -5px;
  }
  .control-movimiento:has(input:checked) span {
    font-size: 0;
  }
  .control-movimiento:has(input:checked) span::after {
    content: "▶";
    font-size: 1rem;
  }
  .cinta {
    display: flex;
    width: max-content;
    animation: deslizar 32s linear infinite;
  }
  ul {
    display: flex;
    gap: 1.5rem;
    padding: 0 1rem;
    margin: 0;
    list-style: none;
    white-space: nowrap;
    font: 1.5rem var(--font-titulo);
    text-transform: uppercase;
  }
  @keyframes deslizar {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .control-movimiento {
      display: none;
    }
    .cinta {
      animation: none;
      width: auto;
    }
    ul {
      flex-wrap: wrap;
      white-space: normal;
    }
    ul[aria-hidden] {
      display: none;
    }
  }
</style>
