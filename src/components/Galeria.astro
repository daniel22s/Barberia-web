---
import { Image, Picture } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import lista from "../content/galeria.json";
import { ordenarComoArchivo } from "../lib/galeria";
import { altConDistrito } from "../lib/seo";
const fotos = ordenarComoArchivo(
  await getCollection("galeria"),
  lista.map(({ id }) => id),
);
const negocio = (await getEntry("negocio", "principal"))!.data;
const tiktok = /^https?:\/\//.test(negocio.redes.tiktok ?? "")
  ? negocio.redes.tiktok
  : undefined;
---

<section id="trabajos" aria-labelledby="titulo-trabajos">
  <p class="etiqueta">Nuestro trabajo</p>
  <h2 class="aparecer" id="titulo-trabajos">
    Resultados reales
  </h2>
  <div class="mosaico">
    {fotos.map(({ data }, indice) => (
      <figure class="aparecer">
        <div class="miniatura">
          {data.imagen.format === "svg" ? (
            <Image
              src={data.imagen}
              alt={
                indice === 0
                  ? altConDistrito(data.alt, negocio.distrito)
                  : data.alt
              }
              loading="lazy"
              decoding="async"
            />
          ) : (
            <Picture
              src={data.imagen}
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              widths={[360, 640, 960, 1280].filter(
                (ancho) => ancho <= data.imagen.width,
              )}
              sizes="(min-width: 1160px) 556px, (min-width: 640px) 48vw, 92vw"
              width={Math.min(data.imagen.width, 1280)}
              height={Math.round(
                (data.imagen.height * Math.min(data.imagen.width, 1280)) /
                  data.imagen.width,
              )}
              quality={55}
              alt={
                indice === 0
                  ? altConDistrito(data.alt, negocio.distrito)
                  : data.alt
              }
              loading="lazy"
              decoding="async"
            />
          )}
        </div>
        {data.publicacionUrl && (
          <figcaption>
            <a
              href={data.publicacionUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {data.publicacionEtiqueta ?? "Ver publicación original"} ↗
            </a>
          </figcaption>
        )}
      </figure>
    ))}
    <div class="tiktok">
      <span aria-hidden="true">↗</span>
      {tiktok ? (
        <a href={tiktok} target="_blank" rel="noopener noreferrer">
          Más en TikTok
        </a>
      ) : (
        <p>
          Más en TikTok
          <br />
          <span class="pendiente">[ENLACE DE TIKTOK PENDIENTE]</span>
        </p>
      )}
    </div>
  </div>
</section>
<style>
  section {
    max-width: 1160px;
    padding: 4rem 1rem;
    margin: auto;
  }
  .etiqueta {
    color: var(--color-acento);
    text-transform: uppercase;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
  }
  h2 {
    font-size: clamp(2.6rem, 5vw, 4rem);
    font-weight: 400;
    text-transform: uppercase;
    margin: 1rem 0 2rem;
  }
  .mosaico {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    max-width: 760px;
    margin-inline: auto;
  }
  figure {
    margin: 0;
    overflow: hidden;
    border-radius: 24px;
    background: var(--color-superficie);
    display: flex;
    flex-direction: column;
  }
  .miniatura {
    position: relative;
    height: clamp(320px, 36vw, 360px);
    overflow: hidden;
    flex: none;
  }
  .miniatura :global(picture) {
    display: block;
    height: 100%;
  }
  .miniatura :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }
  figure:first-child .miniatura :global(img) {
    object-position: center top;
  }
  figcaption {
    padding: 0.75rem 1rem;
  }
  figcaption a {
    display: flex;
    align-items: center;
    min-height: 48px;
    font-weight: 700;
    color: var(--color-acento);
  }
  .tiktok {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
  }
  .tiktok > span {
    color: var(--color-acento);
  }
  .tiktok a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    color: var(--color-acento);
    font-weight: 700;
  }
  .pendiente {
    color: var(--color-apagado);
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }
  @media (min-width: 640px) {
    .mosaico {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
