---
import { getCollection } from "astro:content";
import { preguntasPublicables } from "../lib/jsonld";
const preguntas = preguntasPublicables(
  (await getCollection("faq")).map(({ data }) => data),
);
---

{preguntas.length > 0 && (
  <section aria-labelledby="titulo-faq">
    <h2 id="titulo-faq">Preguntas frecuentes</h2>
    {preguntas.map(({ pregunta, respuesta }) => (
      <details>
        <summary>
          <h3>{pregunta}</h3>
        </summary>
        <p>{respuesta}</p>
      </details>
    ))}
  </section>
)}
<style>
  section {
    max-width: 1160px;
    margin: auto;
    padding: 3rem 1rem;
  }
  h2 {
    font-size: clamp(2.3rem, 4vw, 3.5rem);
    font-weight: 400;
    text-transform: uppercase;
  }
  details {
    border-bottom: 1px solid var(--color-linea);
    padding: 0.5rem 0;
  }
  summary {
    min-height: 48px;
    cursor: pointer;
    padding: 0.75rem 0;
  }
  summary:focus-visible {
    outline: 3px solid var(--color-acento);
    outline-offset: 4px;
  }
  h3 {
    display: inline;
    font: 700 1rem var(--font-texto);
  }
  p {
    color: var(--color-suave);
    line-height: 1.7;
  }
  h3,
  p {
    overflow-wrap: anywhere;
  }
</style>
