---
import { getEntry } from "astro:content";
import Logo from "./Logo.astro";
import { enlaceWhatsApp } from "../lib/whatsapp";
const negocio = (await getEntry("negocio", "principal"))!.data;
---

<header>
  <a class="marca" href="#inicio">
    <Logo />
  </a>
  {[false, true].map((movil) => {
    const Contenedor = movil ? "details" : "div";
    return (
      <Contenedor class={movil ? "menu-movil" : "menu-escritorio"}>
        {movil && (
          <summary>
            Menú <span aria-hidden="true">☰</span>
          </summary>
        )}
        <nav aria-label="Principal">
          <a href="#servicios">Servicios</a>
          <a href="#trabajos">Trabajos</a>
          <a href="#ubicacion">Ubicación</a>
          <a
            class="reserva"
            href={enlaceWhatsApp(negocio.whatsapp, negocio.mensajeWhatsapp)}
          >
            Reservar por WhatsApp
          </a>
        </nav>
      </Contenedor>
    );
  })}
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>(".menu-movil")!;
  menu.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) menu.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu.open) {
      menu.open = false;
      menu.querySelector("summary")!.focus();
    }
  });
</script>
<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem max(1rem, calc((100% - 1160px) / 2));
    border-bottom: 1px solid var(--color-linea);
    position: relative;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  a,
  summary {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
  }
  .reserva {
    border-radius: 99px;
    padding: 0 1.4rem;
    background: var(--color-acento);
    color: var(--color-sobre-acento);
    font-weight: 800;
  }
  .menu-movil {
    display: none;
  }
  summary {
    border: 1px solid var(--color-apagado);
    background: var(--color-superficie);
    color: var(--color-texto);
    border-radius: 14px;
    padding: 0 1rem;
    gap: 0.5rem;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  @media (max-width: 767px) {
    .menu-escritorio {
      display: none;
    }
    .menu-movil {
      display: block;
    }
    nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 1rem;
      background: var(--color-superficie);
      z-index: 10;
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
