---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { enlaceWhatsApp } from "../lib/whatsapp";
import ejemplo from "../assets/galeria/ejemplo.svg";
const negocio = (await getEntry("negocio", "principal"))!.data;
const fotos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/portada.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const foto = Object.values(fotos)[0]?.default ?? ejemplo;
const videos = import.meta.glob<string>("../assets/portada.mp4", {
  eager: true,
  query: "?url",
  import: "default",
});
const video = Object.values(videos)[0];
---

<section id="inicio" aria-labelledby="titular">
  <div class="medio">
    <Image
      src={foto}
      alt={foto === ejemplo ? "[FOTO PRINCIPAL PENDIENTE]" : negocio.eslogan}
      width={720}
      height={720}
      loading="eager"
      fetchpriority="high"
    />
    {video && (
      <video muted autoplay loop playsinline poster={foto.src}>
        <source src={video} type="video/mp4" />
      </video>
    )}
    <span class="sello">Nuevo look</span>
  </div>
  <div class="texto">
    <p class="etiqueta">
      Hair studio unisex en {negocio.distrito}, {negocio.provincia}
    </p>
    <h1 id="titular">{negocio.eslogan}</h1>
    <p class="descripcion">{negocio.descripcion}</p>
    <div class="acciones">
      <a
        class="primario"
        href={enlaceWhatsApp(negocio.whatsapp, negocio.mensajeWhatsapp)}
      >
        Reservar por WhatsApp
      </a>
      <a href="#servicios">Ver servicios y precios</a>
    </div>
    <ul>
      {negocio.horario.map((dia) => (
        <li>
          {dia.dia}: {dia.cerrado ? "Cerrado" : `${dia.apertura}–${dia.cierre}`}
        </li>
      ))}
      {negocio.calificacion && <li>★ {negocio.calificacion} / 5</li>}
    </ul>
  </div>
</section>
<style>
  section {
    max-width: 1160px;
    margin: auto;
    padding: 4rem 1rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .texto {
    grid-column: 1;
    grid-row: 1;
  }
  .medio {
    grid-column: 2;
    grid-row: 1;
    position: relative;
  }
  .medio img,
  .medio video {
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 24px;
  }
  .medio video {
    position: absolute;
    inset: 0;
  }
  .sello {
    position: absolute;
    right: 1rem;
    top: 1rem;
    padding: 0.6rem 1rem;
    border-radius: 99px;
    background: var(--color-acento);
    color: var(--color-sobre-acento);
    font-family: var(--font-titulo);
    text-transform: uppercase;
    transform: rotate(5deg);
  }
  .etiqueta {
    color: var(--color-suave);
    font-size: 0.85rem;
  }
  h1 {
    font-size: clamp(3.6rem, 6vw, 6rem);
    line-height: 1;
    text-transform: uppercase;
    font-weight: 400;
    margin: 1rem 0;
    overflow-wrap: anywhere;
  }
  .descripcion {
    color: var(--color-suave);
    line-height: 1.65;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .acciones a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    border: 1px solid var(--color-texto);
    border-radius: 99px;
    padding: 0 1.25rem;
    font-weight: 800;
    text-align: center;
  }
  .acciones .primario {
    background: var(--color-acento);
    color: var(--color-sobre-acento);
    border-color: var(--color-acento);
  }
  ul {
    list-style: none;
    padding: 0;
    color: var(--color-apagado);
    font-size: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  @media (max-width: 767px) {
    section {
      display: flex;
      flex-direction: column;
      padding: 1.5rem 1rem 2rem;
      gap: 1rem;
    }
    .medio {
      width: 100%;
    }
    .medio img,
    .medio video {
      aspect-ratio: 1.2;
      height: auto;
    }
    .acciones {
      flex-direction: column;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    video {
      display: none;
    }
  }
</style>
