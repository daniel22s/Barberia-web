---
import { getEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { enlaceWhatsApp } from "../lib/whatsapp";
import { obtenerHorario } from "../lib/horario";
import { textoConfirmado, altConDistrito } from "../lib/seo";
import ejemplo from "../assets/galeria/ejemplo.svg";
const negocio = (await getEntry("negocio", "principal"))!.data;
const fotos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/portada.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const foto = Object.values(fotos)[0]?.default ?? ejemplo;
if (foto !== ejemplo && !textoConfirmado(negocio.portadaAlt))
  throw new Error(
    "Completa negocio.portadaAlt con una descripción real de la foto principal.",
  );
const videos = import.meta.glob<string>("../assets/portada.mp4", {
  eager: true,
  query: "?url",
  import: "default",
});
const video = Object.values(videos)[0];
const poster = video
  ? (await getImage({ src: foto, width: 720, height: 720 })).src
  : undefined;
---

<section id="inicio" aria-labelledby="titular">
  <div class="medio">
    <Image
      src={foto}
      alt={
        foto === ejemplo
          ? "[FOTO PRINCIPAL PENDIENTE]"
          : altConDistrito(negocio.portadaAlt!, negocio.distrito)
      }
      width={720}
      height={720}
      loading="eager"
      fetchpriority="high"
    />
    {video && (
      <video
        data-video-portada
        controls
        aria-label="Video de nuestros trabajos"
        muted
        loop
        playsinline
        preload="none"
        poster={poster}
        hidden
      >
        <source data-src={video} type="video/mp4" />
      </video>
    )}
    <div class="escultura" aria-hidden="true">
      <div class="orbita"></div>
      <div class="poste">
        <div class="bandas"></div>
      </div>
      <div class="base-poste"></div>
    </div>
    <span class="sello">Nuevo look</span>
  </div>
  <div class="texto">
    <p class="etiqueta">
      Hair studio unisex en {negocio.distrito}, {negocio.provincia}
    </p>
    <h1 class="aparecer" id="titular">
      {negocio.eslogan}
    </h1>
    <p class="descripcion">{negocio.descripcion}</p>
    <div class="acciones">
      <a
        class="primario"
        href={enlaceWhatsApp(negocio.whatsapp, negocio.mensajeWhatsapp)}
      >
        Reservar por WhatsApp
      </a>
      <a href="#servicios">Ver servicios y precios</a>
    </div>
    <ul>
      {obtenerHorario(negocio.horario, new Date()).resumen.map((resumen) => (
        <li>{resumen}</li>
      ))}
      {negocio.horarioNota && <li>{negocio.horarioNota}</li>}
      {negocio.calificacion && <li>★ {negocio.calificacion} / 5</li>}
    </ul>
  </div>
</section>
<style>
  section {
    overflow: clip;
    max-width: 1160px;
    margin: auto;
    padding: 4rem 1rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .texto {
    grid-column: 1;
    grid-row: 1;
  }
  .medio {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    isolation: isolate;
  }
  .medio::before {
    content: "";
    position: absolute;
    inset: 8% -8px -12px 8%;
    border: 1px solid var(--color-acento);
    border-radius: 28px;
    transform: rotate(3deg);
    z-index: -1;
  }
  .medio::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 24px;
    background: linear-gradient(145deg, transparent 45%, #0008);
    pointer-events: none;
  }
  .medio img,
  .medio video {
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 24px;
  }
  .medio video {
    position: absolute;
    inset: 0;
  }
  .escultura {
    position: absolute;
    bottom: 8%;
    right: 6%;
    width: 100px;
    height: 210px;
    z-index: 1;
    transform-style: preserve-3d;
    transform: perspective(700px) rotateZ(12deg) rotateY(-18deg);
    pointer-events: none;
  }
  .poste {
    position: absolute;
    inset: 20px 21px 24px;
    overflow: hidden;
    border: 2px solid var(--color-acento);
    border-radius: 20px;
    background: var(--color-fondo);
    box-shadow:
      12px 16px 22px #0008,
      inset 0 0 15px #000;
  }
  .poste::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      #000b,
      transparent 25%,
      #ffffff90 38%,
      transparent 56%,
      #000b
    );
  }
  .bandas {
    position: absolute;
    inset: -80px 0;
    background: repeating-linear-gradient(
      -35deg,
      var(--color-acento) 0 17px,
      var(--color-fondo) 17px 34px,
      var(--color-texto) 34px 51px,
      var(--color-fondo) 51px 68px
    );
  }
  .base-poste {
    position: absolute;
    inset: auto 8px 0;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(
      90deg,
      var(--color-acento),
      var(--color-texto),
      var(--color-acento)
    );
    box-shadow: 0 12px 20px #0007;
  }
  .orbita {
    position: absolute;
    inset: -8px -24px;
    border: 1px solid var(--color-acento);
    border-radius: 50%;
    transform: rotateY(55deg) rotateX(22deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .escultura {
      animation: flotar-poste 7s ease-in-out infinite alternate;
    }
    .bandas {
      animation: girar-bandas 3s linear infinite;
    }
  }
  @keyframes flotar-poste {
    to {
      transform: perspective(700px) translateY(-18px) rotateZ(-9deg)
        rotateY(22deg);
    }
  }
  @keyframes girar-bandas {
    to {
      transform: translateY(83px);
    }
  }
  .sello {
    position: absolute;
    z-index: 1;
    box-shadow: 0 8px 24px #0005;
    right: 1rem;
    top: 1rem;
    padding: 0.6rem 1rem;
    border-radius: 99px;
    background: var(--color-acento);
    color: var(--color-sobre-acento);
    font-family: var(--font-titulo);
    text-transform: uppercase;
    transform: rotate(5deg);
  }
  .etiqueta {
    color: var(--color-suave);
    font-size: 0.85rem;
  }
  h1 {
    font-size: clamp(3.6rem, 6vw, 6rem);
    line-height: 1;
    text-transform: uppercase;
    font-weight: 400;
    margin: 1rem 0;
    overflow-wrap: anywhere;
  }
  .descripcion {
    color: var(--color-suave);
    line-height: 1.65;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .acciones a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    border: 1px solid var(--color-texto);
    border-radius: 99px;
    padding: 0 1.25rem;
    font-weight: 800;
    text-align: center;
  }
  .acciones .primario {
    background: var(--color-acento);
    color: var(--color-sobre-acento);
    border-color: var(--color-acento);
  }
  ul {
    list-style: none;
    padding: 0;
    color: var(--color-apagado);
    font-size: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  @media (max-width: 767px) {
    section {
      display: flex;
      flex-direction: column;
      padding: 1.5rem 1rem 2rem;
      gap: 1rem;
    }
    .medio {
      width: 100%;
    }
    .medio img,
    .medio video {
      aspect-ratio: 1.2;
      height: auto;
    }
    .acciones {
      flex-direction: column;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    video {
      display: none;
    }
  }
</style>
