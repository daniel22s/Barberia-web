---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getEntry } from "astro:content";

const negocio = (await getEntry("negocio", "principal"))!.data;
// SVG tiene prioridad si se entregan ambos archivos. Sin archivo, usar texto.
const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/logo.{svg,png}",
  { eager: true },
);
const logo =
  imagenes["/src/assets/logo.svg"]?.default ??
  imagenes["/src/assets/logo.png"]?.default;
---

<span class="logo">
  {
    logo ? (
      <Image
        src={logo}
        alt={negocio.nombre}
        width={200}
        height={Math.round((200 * logo.height) / logo.width)}
      />
    ) : (
      <span class="logo-texto">
        <span class="nombre">{negocio.logoTexto}</span>
        <span class="subtexto">{negocio.logoSubtexto}</span>
      </span>
    )
  }
</span>

<style>
  .logo,
  .logo-texto {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }
  .logo {
    max-width: 200px;
    color: var(--color-texto);
  }
  .logo :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    max-height: 64px;
    object-fit: contain;
  }
  .nombre {
    font-family: "Syncopate", sans-serif;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 3px;
  }
  .subtexto {
    margin-top: 6px;
    padding-left: 5px;
    font-family: var(--font-texto);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 5px;
  }
  @media (max-width: 767px) {
    .nombre {
      font-size: 20px;
    }
  }
</style>
